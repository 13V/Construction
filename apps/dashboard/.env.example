# Supabase — required. See DEPLOY.md at the repo root.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side. SUPABASE_SERVICE_ROLE_KEY bypasses row-level security —
# never give it a VITE_ prefix or Vite will bundle it into the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Map tiles. Optional — defaults to OpenFreeMap's public instance, which needs
# no key. Point this at your own tile server if you self-host.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
