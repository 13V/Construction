# Google Maps — required. See MAPS.md at the repo root.
# Enable "Maps JavaScript API" and turn on billing, or the map renders
# a darkened "For development purposes only" watermark.
VITE_GOOGLE_MAPS_API_KEY=

# Advanced Markers require a Map ID. DEMO_MAP_ID works for development;
# create a real one to apply mapStyle.json in the Cloud Console.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Supabase — only needed when switching off the simulated feed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
