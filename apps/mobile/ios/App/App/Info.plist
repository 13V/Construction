<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Crewline</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- No UIRequiredDeviceCapabilities entry: armv7 was a 32-bit-era flag that
	     blocks nothing on a modern install (every current device is arm64) and
	     App Store Connect has rejected 32-bit-only binaries for years, so the
	     key is pure vestige, not a real requirement. Declaring "armv7" is
	     actively wrong now — it advertises a 32-bit instruction set this
	     arm64-only build does not contain, which is the kind of mismatch App
	     Store static analysis flags. Omitting the key is correct: the App Store
	     already enforces device compatibility from the build's own architecture
	     and Deployment Info, so nothing here needs to assert it by hand. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!--
	  iOS shows these strings verbatim in the permission prompt, so they are
	  written for the person holding the phone, not for an App Store reviewer.
	  A vague one gets declined, and a declined permission means a worker's
	  hours silently stop being recorded.
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Crewline clocks you in automatically when you arrive at a job site.</string>

	<!--
	  "Always" is the one that matters. Without it iOS only reports while the
	  app is open, which is the failure the native app exists to fix — a phone
	  goes in a pocket and the worker stops being on the clock.

	  The string used to say location was "only used while you have tracking
	  switched on", true but read alongside the first sentence as "only near a
	  job site" — it is not. Once tracking is on, every fix is recorded the
	  whole time, on the drive to site and back, not only at arrival and
	  departure. A vague description gets the permission declined by App
	  Review, and an inaccurate one is worse: it is the sentence a worker reads
	  before deciding whether to trust the app with their location.
	-->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Crewline records your location continuously while tracking is switched on — not only near a job site — so your hours keep recording with your phone in your pocket. Choose "Always" so this keeps working with the screen off. Turn tracking off any time to stop.</string>

	<!-- Without the location background mode, iOS suspends the app and the
	     fixes stop the moment the screen locks. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<key>NSCameraUsageDescription</key>
	<string>Take site photos and photograph receipts.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save site photos you take in Crewline.</string>

	<!--
	  Every network call the app makes is HTTPS to Vercel and Supabase, and the
	  only cryptography beyond TLS is Supabase's own auth (JWT session tokens
	  over that same TLS connection) — both are the standard, OS-provided
	  encryption Apple's export rules call "exempt", and nothing in this app
	  implements or bundles its own cipher. Declaring the answer here is what
	  stops App Store Connect asking on every single upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
